# ==============================================================================
# Global Syncro - Variáveis de Ambiente de Exemplo
# ==============================================================================

# Obtenha suas chaves em https://api.windy.com/keys

# 1. Windy Webcams API v3 (Global Webcams & Timelapses)
WINDY_API_KEY_WEBCAMS=sua_chave_windy_webcams_aqui

# 2. Windy Map Forecast API (Interactive Weather Maps & Animated Wind Particle Layers)
WINDY_API_KEY_MAP_FORECAST=sua_chave_windy_map_forecast_aqui

# 3. Windy Point Forecast API v2 (Hourly Weather, Temperature, Wind, Humidity, Rain)
WINDY_API_KEY_POINT_FORECAST=sua_chave_windy_point_forecast_aqui

# Servidor Local
PORT=4173
HOST=127.0.0.1
